#!/usr/bin/env bash
set -euo pipefail

readonly BUN_VERSION="1.3.14"
readonly BUN_INSTALL="${HOME}/.bun"
readonly PROFILE_MARKER="# Prism orb Bun toolchain"

export BUN_INSTALL
export PATH="${BUN_INSTALL}/bin:${PATH}"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

install_bun() {
  if [[ -x "${BUN_INSTALL}/bin/bun" ]] && [[ "$("${BUN_INSTALL}/bin/bun" --version)" == "$BUN_VERSION" ]]; then
    printf 'Bun %s is already installed at %s\n' "$BUN_VERSION" "${BUN_INSTALL}/bin/bun"
    return
  fi

  curl --fail --silent --show-error --location https://bun.sh/install \
    | bash -s -- "bun-v${BUN_VERSION}"
}

persist_bun_path() {
  touch "${HOME}/.bash_profile"
  if ! grep -Fqx "$PROFILE_MARKER" "${HOME}/.bash_profile"; then
    cat >> "${HOME}/.bash_profile" <<'EOF'

# Prism orb Bun toolchain
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
EOF
  fi
}

run_step "Install Bun ${BUN_VERSION}" install_bun
persist_bun_path

if [[ "$(bun --version)" != "$BUN_VERSION" ]]; then
  printf 'Expected Bun %s, found %s at %s\n' "$BUN_VERSION" "$(bun --version)" "$(command -v bun)" >&2
  exit 1
fi

run_step "Install locked dependencies" bun install --frozen-lockfile --cpu='*' --os='*'
run_step "Build Prism SDK" bun run build:core

prepare_tailscale_and_quasar() {
  # Install clients only: authentication belongs in resume, never in a shared snapshot.
  sudo install -d /etc/systemd/system/tailscaled.service.d
  sudo tee /etc/systemd/system/tailscaled.service.d/amp-orb.conf >/dev/null <<'EOF'
[Service]
Environment=TS_ASSUME_NETWORK_UP_FOR_TEST=true
EOF
  if ! command -v tailscale >/dev/null 2>&1; then
    curl -fsSL https://tailscale.com/install.sh | sh
  fi
  sudo systemctl daemon-reload
  # Start a stopped daemon; never restart an already-running one.
  sudo systemctl enable --now tailscaled

  local quasar_version=0.5.3
  local quasar_package="${HOME}/.local/lib/node_modules/@skastr0/quasar-cli/package.json"
  if [[ ! -x "${HOME}/.local/bin/quasar" ]] ||
     [[ "$(node -p 'require(process.argv[1]).version' "$quasar_package" 2>/dev/null || true)" != "$quasar_version" ]]; then
    npm install --global --prefix "${HOME}/.local" "@skastr0/quasar-cli@${quasar_version}"
  fi
}

run_step "Prepare Tailscale and Quasar clients" prepare_tailscale_and_quasar

printf '\nOrb setup complete with Bun %s.\n' "$(bun --version)"
