{
  "name": "@skastr0/prism-workspace",
  "version": "0.3.0",
  "description": "Unified plugin distribution system for AI coding harnesses",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/npm/*",
    "packages/prism-sdk"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./packager": "./src/packager.ts"
  },
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build": "bun run build:cli",
    "build:cli": "bun scripts/build.ts",
    "build:core": "tsc -p packages/prism-sdk/tsconfig.json",
    "build:npm-cli": "bun scripts/build-npm-cli-packages.ts",
    "install:dev": "bun scripts/install.ts",
    "install:local": "bun run install:dev",
    "typecheck": "tsc --noEmit",
    "verify": "bun run build:core && bun run typecheck && bun run build && bun run check:harness-enumeration && bun run acceptance:mcp-shim-compiled-binary",
    "verify:compiled": "bun run build:core && bun run acceptance:mcp-shim-compiled-binary",
    "pack:npm-cli:dry-run": "npm pack --dry-run --workspace packages/npm/prism-darwin-arm64 --workspace packages/npm/prism-darwin-x64 --workspace packages/npm/prism-linux-arm64 --workspace packages/npm/prism-linux-x64 --workspace packages/npm/prism",
    "pack:core:dry-run": "npm pack --dry-run --workspace packages/prism-sdk",
    "smoke:core": "bun run build:core && bun run pack:core:dry-run && bun scripts/smoke-prism-sdk-package.ts",
    "smoke:npm-cli": "bun run build:npm-cli && bun run pack:npm-cli:dry-run && bun scripts/smoke-npm-cli.ts --skip-build",
    "check:effect-versions": "bun scripts/effect-version-guard.ts",
    "check:harness-enumeration": "bun scripts/harness-enumeration-guard.ts",
    "check:refresh-idempotency": "bun scripts/check-refresh-idempotency.ts",
    "check:commits": "commitlint",
    "test": "bun test",
    "acceptance:idempotency-git": "bun scripts/acceptance/idempotency-git.ts",
    "acceptance:crash-convergence": "bun scripts/acceptance/crash-convergence.ts",
    "acceptance:mcp-determinism": "bun scripts/acceptance/mcp-determinism.ts",
    "acceptance:mcp-shim-compiled-binary": "bun scripts/acceptance/mcp-shim-compiled-binary.ts",
    "acceptance:orbit-workflows": "bun scripts/acceptance/orbit-workflows.ts",
    "acceptance:workflow-e2e": "bun scripts/acceptance/workflow-e2e-matrix.ts",
    "acceptance:all": "bun scripts/acceptance/run-all.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentui/core": "0.4.1",
    "@opentui/react": "0.4.1",
    "@skastr0/prism-sdk": "workspace:*",
    "@opencode-ai/plugin": "^1.15.13",
    "commander": "^13.1.0",
    "effect": "^3.21.1",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "react": "19.2.7",
    "typescript": "^5.8.3",
    "zod": "4.4.3"
  },
  "overrides": {
    "uuid": "13.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/bun": "^1.2.14",
    "@types/react": "^19.2.7",
    "fast-check": "^4.8.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/prism.git"
  },
  "homepage": "https://github.com/skastr0/prism#readme",
  "bugs": {
    "url": "https://github.com/skastr0/prism/issues"
  }
}
