{
  "name": "agentpkg",
  "version": "0.1.0",
  "description": "Unified plugin distribution system for AI coding harnesses",
  "type": "module",
  "private": true,
  "packageManager": "bun@latest",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build": "bun scripts/build.ts",
    "install:local": "bun scripts/install.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "commander": "^13.1.0",
    "effect": "^3.21.1",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.14",
    "@types/bun": "^1.2.14",
    "typescript": "^5.8.3"
  }
}
