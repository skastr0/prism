{
  "name": "@skastr0/prism-sdk",
  "version": "0.8.1",
  "type": "module",
  "description": "Core Prism contracts, refs, stable JSON, and manifest codecs shared by Prism workflows and the Prism CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/prism.git",
    "directory": "packages/prism-sdk"
  },
  "homepage": "https://github.com/skastr0/prism#readme",
  "bugs": {
    "url": "https://github.com/skastr0/prism/issues"
  },
  "keywords": [
    "prism",
    "agents",
    "workflows",
    "effect",
    "manifest"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./compile-manifest": {
      "types": "./dist/compile-manifest.d.ts",
      "import": "./dist/compile-manifest.js"
    },
    "./refs": {
      "types": "./dist/refs.d.ts",
      "import": "./dist/refs.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    },
    "./stable-json": {
      "types": "./dist/stable-json.d.ts",
      "import": "./dist/stable-json.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  }
}
